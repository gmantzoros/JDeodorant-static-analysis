<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="JDeodorant Batch" uid="jdeodorant.batch" id="gr.uom.java.jdeodorant.batchProduct" application="gr.uom.java.jdeodorant.batch" version="5.0.85" type="features" includeLaunchers="true" autoIncludeRequirements="true">

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <programArgs>-consoleLog -nosplash --launcher.suppressErrors
      </programArgs>
      <vmArgs>-Xmx4g -Dosgi.requiredJavaVersion=21
      </vmArgs>
   </launcherArgs>

   <launcher name="jdeodorant-batch">
   </launcher>

   <features>
      <feature id="gr.uom.java.jdeodorant.feature"/>
      <feature id="org.eclipse.jdt"/>
      <feature id="org.eclipse.platform"/>
      <feature id="org.eclipse.equinox.executable" installMode="root"/>
   </features>

   <configurations>
      <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="4" />
      <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.event" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.simpleconfigurator" autoStart="true" startLevel="1" />
   </configurations>

</product>
