<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Tycho build of the JDeodorant plug-in. Build with: mvn -B clean verify -->
  <groupId>gr.uom.java</groupId>
  <artifactId>gr.uom.java.jdeodorant</artifactId>
  <version>5.0.85</version>
  <packaging>eclipse-plugin</packaging>

  <properties>
    <tycho.version>5.0.4</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Eclipse release the plug-in is built and run against -->
    <eclipse.release.url>https://download.eclipse.org/releases/2025-06/</eclipse.release.url>
  </properties>

  <repositories>
    <repository>
      <id>eclipse-release</id>
      <layout>p2</layout>
      <url>${eclipse.release.url}</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <environments>
            <environment>
              <os>win32</os>
              <ws>win32</ws>
              <arch>x86_64</arch>
            </environment>
            <environment>
              <os>linux</os>
              <ws>gtk</ws>
              <arch>x86_64</arch>
            </environment>
          </environments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
